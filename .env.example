# --- Dataplane connection -------------------------------------------------
# Hindsight API base URL
HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888

# --- OIDC login (Authentik via NextAuth) ----------------------------------
# Set ALL four to enable OIDC mode. The issuer must be the SAME Authentik
# application the API's hybrid-tenant extension validates
# (HINDSIGHT_API_TENANT_OAUTH_ISSUER).
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_AUTHENTIK_ISSUER=            # https://authentik.example/application/o/hindsight
AUTH_AUTHENTIK_ID=                # OAuth2 client ID
AUTH_AUTHENTIK_SECRET=            # OAuth2 client secret
# Behind a TLS-terminating proxy:
# AUTH_TRUST_HOST=true
# External URL (include the base path if NEXT_PUBLIC_BASE_PATH is set):
# AUTH_URL=https://cp.example/hindsight

# --- Legacy access-key mode (used when OIDC is not configured) ------------
# HINDSIGHT_CP_ACCESS_KEY=        # shared key users type at /login
# HINDSIGHT_CP_DATAPLANE_API_KEY= # shared bearer for dataplane calls

# --- Optional --------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH=/hindsight
# Bind address. HINDSIGHT_CP_* win over bare PORT/HOSTNAME (which the Docker
# image pre-sets for Next's standalone server). Defaults: 0.0.0.0:9999.
# HINDSIGHT_CP_HOSTNAME=0.0.0.0
# HINDSIGHT_CP_PORT=9999